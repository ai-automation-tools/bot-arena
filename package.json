{
  "name": "bot-arena",
  "version": "0.2.0",
  "description": "A local arena where your own AI agents play each other in rule-checked chess, tic-tac-toe and Connect Four, over MCP, REST, webhooks or JavaScript.",
  "license": "MIT",
  "homepage": "https://bot-arena.ai-automation-tools.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-automation-tools/bot-arena.git"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "chess",
    "tic-tac-toe",
    "connect-four",
    "game-ai",
    "arena"
  ],
  "mcpName": "io.github.ai-automation-tools/bot-arena",
  "bin": {
    "bot-arena": "bin/bot-arena.mjs"
  },
  "files": [
    "bin/",
    ".next/",
    "!.next/cache/",
    "!.next/dev/",
    "!.next/trace*",
    "!.next/diagnostics/",
    "!.next/types/",
    "next.config.ts"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 9002",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "next start -H 127.0.0.1 -p 9002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "demo:matches": "tsx scripts/generate-demo-matches.ts",
    "examples:test": "node scripts/examples-test.mjs",
    "prepack": "next build && node scripts/pack-externals.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.4.1",
    "chess": "npm:chess.js@^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8",
    "tailwindcss": "^4.3.5",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.31"
    },
    "minimatch": "^11.0.1",
    "test-exclude": "^8.0.0",
    "glob@>=9.0.0 <14.0.2": "^14.0.2"
  }
}

# Bot Arena: optional settings. Copy to .env.local to change any of them; none are required.

# Where finished matches are saved, one JSON file each. Default: .arena (relative to the repo root)
ARENA_DATA_DIR=

# Extra host names allowed to call the API, comma-separated (localhost and 127.0.0.1 always are).
# Only set this when you serve the arena to other machines, and put it behind something that
# authenticates first: the API runs agents and plays moves without logging in.
ARENA_ALLOWED_HOSTS=

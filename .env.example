# Bot Arena: optional settings. Copy to .env.local to change any of them; none are required.

# Where finished matches are saved, one JSON file each. Default: .arena (relative to the repo root)
ARENA_DATA_DIR=

# An access key for setups reachable from other machines. When set, every page and API call needs it:
# agents send it as the X-Arena-Key header, and a browser enters it once at /unlock. Make it long and
# random, e.g. `openssl rand -hex 24`. Leave empty on your own machine.
ARENA_API_KEY=

# Extra host names allowed to call the API, comma-separated (localhost and 127.0.0.1 always are).
# Only set this when you serve the arena to other machines, and set ARENA_API_KEY with it: without a
# key, the API runs agents and plays moves for anyone who can reach it.
ARENA_ALLOWED_HOSTS=
